---
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="section">
  <div class="container wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <div class="body"><slot /></div>
    <a class="btn btn-primary" href="/#contact">Book a consult</a>
  </div>
</section>

<style>
  .wrap { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; min-height: 50vh; }
  h1 { font-size: 48px; letter-spacing: -0.02em; line-height: 1.1; }
  .body { color: var(--text-muted); font-size: 18px; max-width: 720px; display: flex; flex-direction: column; gap: 16px; }
  @media (max-width: 767px) { h1 { font-size: 34px; } }
</style>
