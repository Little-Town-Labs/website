---
import ContactForm from './ContactForm.astro';
import { contact } from '../data/site';

interface Props {
  /** Render the title as the page's H1 (standalone /contact route). */
  asH1?: boolean;
}
const { asH1 = false } = Astro.props;
const Heading = asH1 ? 'h1' : 'h2';
---

<section id="contact" class="alt">
  <div class="container section grid">
    <div class="copy">
      <Heading class="h2">{contact.title}</Heading>
      <p>{contact.body}</p>
    </div>
    <ContactForm />
  </div>
</section>

<style>
  .alt { background: var(--ground-alt); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 56px;
  }
  .copy { display: flex; flex-direction: column; gap: 16px; }
  .copy p { color: var(--text-muted); font-size: 18px; }
</style>
