---
import ContactForm from './ContactForm.astro';
import { contact, site } from '../data/site';

interface Props {
  /** Render the title as the page's H1 (standalone /contact route). */
  asH1?: boolean;
}
const { asH1 = false } = Astro.props;
const Heading = asH1 ? 'h1' : 'h2';
---

<section id="contact" class="alt">
  <div class="container section grid">
    <div class="copy">
      <Heading class="h2">{contact.title}</Heading>
      <p>{contact.body}</p>
      <a class="btn btn-primary" href={contact.bookingCta.href}>{contact.bookingCta.label}</a>
      <p class="email">{contact.emailNote} <a href={`mailto:${site.email}`}>{site.email}</a><br /><span>{contact.emailPhiNote}</span></p>
    </div>
    <ContactForm />
  </div>
</section>

<style>
  .alt { background: var(--ground-alt); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 56px;
  }
  .copy { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .copy :global(.h2) { text-wrap: balance; }
  .copy p { color: var(--text-muted); font-size: 18px; }
  .copy .email { font-size: 16px; }
  .copy .email span { font-size: 14px; }
</style>
