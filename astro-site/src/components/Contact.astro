---
import ContactForm from './ContactForm.astro';
import { contact } from '../data/site';
---

<section id="contact" class="alt">
  <div class="container section grid">
    <div class="copy">
      <h2 class="h2">{contact.title}</h2>
      <p>{contact.body}</p>
    </div>
    <ContactForm />
  </div>
</section>

<style>
  .alt { background: var(--ground-alt); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 56px;
  }
  .copy { display: flex; flex-direction: column; gap: 16px; }
  .copy p { color: var(--text-muted); font-size: 18px; }
</style>
