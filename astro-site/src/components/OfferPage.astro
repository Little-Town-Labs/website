---
import type { OfferPageContent } from '../data/offers';

interface Props {
  content: OfferPageContent;
}
const { content: c } = Astro.props;
---

<section class="hero on-dark">
  <div class="container copy">
    <p class="eyebrow">{c.hero.eyebrow}</p>
    <h1>{c.hero.title}</h1>
    <p class="sub">{c.hero.subhead}</p>
    <div class="ctas">
      <a class="btn btn-primary" href={c.hero.primaryCta.href}>{c.hero.primaryCta.label}</a>
      <a class="btn btn-secondary" href={c.hero.secondaryCta.href}>{c.hero.secondaryCta.label}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container wrap">
    <div class="intro">
      <p class="eyebrow">{c.outcomes.eyebrow}</p>
      <h2 class="h2">{c.outcomes.title}</h2>
      <p class="lede">{c.outcomes.intro}</p>
    </div>
    <div class="grid outcomes">
      {c.outcomes.items.map((o) => (
        <article class="card">
          <p class="label">Today</p>
          <p class="problem">{o.problem}</p>
          <p class="label gain">With us</p>
          <p class="outcome">{o.outcome}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id={c.offerings.id} class="section alt">
  <div class="container wrap">
    <div class="intro">
      <p class="eyebrow">{c.offerings.eyebrow}</p>
      <h2 class="h2">{c.offerings.title}</h2>
      <p class="lede">{c.offerings.intro}</p>
    </div>
    <div class="grid offerings" data-count={c.offerings.items.length}>
      {c.offerings.items.map((o) => (
        <article class="card">
          <h3>{o.title}</h3>
          <p class="muted">{o.body}</p>
          <ul class="bullets">{o.bullets.map((b) => <li>{b}</li>)}</ul>
          {o.fit && <p class="fit">{o.fit}</p>}
        </article>
      ))}
    </div>
    {c.offerings.note && <p class="note">{c.offerings.note}</p>}
  </div>
</section>

{c.examples && (
  <section class="section">
    <div class="container wrap">
      <div class="intro">
        <h2 class="h2">{c.examples.title}</h2>
        <p class="lede">{c.examples.intro}</p>
      </div>
      <ul class="examples">{c.examples.items.map((e) => <li>{e}</li>)}</ul>
    </div>
  </section>
)}

{c.notes.map((n) => (
  <section class="callout-wrap">
    <div class="container">
      <div class="callout">
        <h2>{n.title}</h2>
        <p>{n.body}</p>
        {n.link && <a class="more" href={n.link.href}>{n.link.label}</a>}
      </div>
    </div>
  </section>
))}

<section class="section">
  <div class="container wrap">
    <h2 class="h2">{c.steps.title}</h2>
    <ol class="steps">
      {c.steps.items.map((s) => (
        <li>
          <p class="tag">{s.tag}</p>
          <h3>{s.title}</h3>
          <p class="muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section alt">
  <div class="container wrap narrow">
    <h2 class="h2">{c.faq.title}</h2>
    <div class="faq">
      {c.faq.items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="closing on-dark">
  <div class="container copy">
    <h2>{c.closing.title}</h2>
    <p class="sub">{c.closing.body}</p>
    <div class="ctas">
      <a class="btn btn-primary" href={c.closing.cta.href}>{c.closing.cta.label}</a>
    </div>
  </div>
</section>

<style>
  .hero, .closing { background: var(--ink); color: var(--ground); }
  .copy { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .hero .copy { padding-block: 96px 104px; }
  .closing .copy { padding-block: 80px; }
  h1 { font-size: 56px; line-height: 1.05; font-weight: 700; letter-spacing: -0.02em; max-width: 820px; }
  .closing h2 { font-size: 40px; letter-spacing: -0.01em; max-width: 720px; }
  .sub { font-size: 20px; color: var(--text-on-dark); max-width: 680px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 16px; }

  .alt { background: var(--ground-alt); }
  .wrap { display: flex; flex-direction: column; gap: 40px; }
  .narrow { max-width: 860px; }
  .intro { display: flex; flex-direction: column; gap: 12px; max-width: 720px; }
  .lede { color: var(--text-muted); font-size: 18px; }
  .muted { color: var(--text-muted); }

  .grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 700px) {
    .outcomes, .offerings:not([data-count='3']) { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .offerings[data-count='3'] { grid-template-columns: repeat(3, 1fr); }
  }
  article { display: flex; flex-direction: column; gap: 12px; }
  h3 { font-size: 22px; }

  .label { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--subtle); }
  .label.gain { color: var(--accent); margin-top: 8px; }
  .problem { color: var(--text-muted); }
  .outcome { font-weight: 600; font-size: 18px; }
  .fit { margin-top: auto; font-family: var(--font-mono); font-size: 14px; color: var(--accent); }
  .note { font-family: var(--font-mono); font-size: 15px; color: var(--ink); }

  .examples {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr; gap: 12px;
  }
  @media (min-width: 700px) { .examples { grid-template-columns: repeat(2, 1fr); } }
  .examples li {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-btn);
    padding: 16px 20px; border-left: 4px solid var(--accent);
  }

  .callout-wrap { padding-block: 0 24px; }
  .callout {
    background: var(--ink); color: var(--text-on-dark);
    border-radius: var(--radius-card); padding: 40px; display: flex; flex-direction: column; gap: 14px; max-width: 860px;
  }
  .callout h2 { color: var(--ground); font-size: 28px; }
  .callout .more { color: var(--accent-on-dark); font-weight: 600; width: fit-content; }
  .callout .more:hover { color: #fff; }

  .steps {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 24px;
  }
  .steps li { display: flex; flex-direction: column; gap: 10px; border-top: 3px solid var(--ink); padding-top: 20px; }
  .tag { font-family: var(--font-mono); color: var(--accent); font-size: 14px; text-transform: uppercase; }

  .faq { display: flex; flex-direction: column; }
  details { border-top: 1px solid var(--line); padding-block: 4px; }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; font-weight: 600; font-size: 18px; padding-block: 16px; min-height: 44px; }
  details p { color: var(--text-muted); padding-bottom: 20px; max-width: 720px; }

  @media (max-width: 767px) {
    .hero .copy { padding-block: 56px 64px; }
    .closing .copy { padding-block: 56px; }
    h1 { font-size: 38px; }
    .closing h2 { font-size: 30px; }
    .sub { font-size: 18px; }
    .ctas .btn { width: 100%; justify-content: center; text-align: center; }
    .callout { padding: 28px; }
  }
</style>
