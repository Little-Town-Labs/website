---
import { about, site } from '../data/site';
---

<section id="about" class="section">
  <div class="container grid">
    <img src={about.photo} alt={about.photoAlt} width="380" height="475" loading="lazy" />
    <div class="copy">
      <p class="eyebrow">{about.eyebrow}</p>
      <h2>{about.title}</h2>
      <p class="lead">{about.body}</p>
      <ul class="bullets">{about.credentials.map((c) => <li>{c}</li>)}</ul>
      <p class="partner">Delivered in partnership with <a href={site.partnerUrl}>Timeless Technology Solutions</a>.</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 56px;
    align-items: start;
  }
  img {
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
    background: #e2e6e4;
  }
  .copy { display: flex; flex-direction: column; gap: 20px; }
  h2 { font-size: 36px; }
  .lead { color: var(--text-muted); font-size: 18px; }
  .partner { color: var(--text-muted); }
</style>
