---
import { protection } from '../data/site';
---

<section class="outer">
  <div class="container">
    <div class="panel">
      <div class="head">
        <h2>{protection.title}</h2>
        <p>{protection.body}</p>
      </div>
      <div class="rows">
        {protection.rows.map((row) => (
          <div class="row">
            <span class="label">{row.label}</span>
            {row.steps.map((step, i) => (
              <>
                {i > 0 && <span class="arrow" aria-hidden="true">→</span>}
                <span class:list={['step', { mid: i === 1, ink: i === 1 && row.highlight === 'ink', accent: i === 1 && row.highlight === 'accent' }]}>{step}</span>
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .outer { padding-block: 56px 104px; }
  .panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .head { display: flex; flex-direction: column; gap: 8px; }
  h2 { font-size: 28px; }
  .head p { color: var(--text-muted); max-width: 720px; }
  .rows { display: flex; flex-direction: column; gap: 20px; font-family: var(--font-mono); font-size: 14px; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .label { width: 120px; color: var(--subtle); text-transform: uppercase; }
  .arrow { color: var(--subtle); }
  .step { padding: 12px 16px; border: 1px solid #c5ccca; border-radius: var(--radius-btn); }
  .step.ink { background: var(--ink); color: var(--ground); border-color: var(--ink); }
  .step.accent { background: var(--accent); color: #fff; border-color: var(--accent); }

  @media (max-width: 767px) {
    .outer { padding-block: 32px 64px; }
    .panel { padding: 24px; }
    .label { width: 100%; }
    /* Stack steps vertically with a downward arrow so the flow wraps cleanly. */
    .row { flex-direction: column; align-items: stretch; gap: 8px; }
    .arrow { align-self: center; transform: rotate(90deg); }
  }
</style>
