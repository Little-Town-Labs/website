---
import Base from '../layouts/Base.astro';
import OfferPage from '../components/OfferPage.astro';
import { legal } from '../data/offers';
import { offerGraph } from '../data/seo';

const graph = offerGraph(legal, '/legal/', {
  name: 'Legal',
  serviceType: 'Safe AI implementation and redaction for law firms',
  audience: 'Law firms',
});
---

<Base title={legal.seo.title} description={legal.seo.description} graph={graph}>
  <OfferPage content={legal} />
</Base>
