---
import Base from '../layouts/Base.astro';
import OfferPage from '../components/OfferPage.astro';
import { healthcare } from '../data/offers';
import { offerGraph } from '../data/seo';

const graph = offerGraph(healthcare, '/healthcare/', {
  name: 'Healthcare',
  serviceType: 'HIPAA de-identification, analytics, and safe AI implementation for healthcare',
  audience: 'Clinics, health systems, and health tech teams',
});
---

<Base title={healthcare.seo.title} description={healthcare.seo.description} graph={graph}>
  <OfferPage content={healthcare} />
</Base>
