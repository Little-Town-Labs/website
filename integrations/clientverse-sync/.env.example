# Quote every value: Clientverse tokens contain "|", which breaks an unquoted .env when sourced.
NETLIFY_TOKEN=            # Netlify personal access token (read access to the site's forms)
NETLIFY_SITE_ID=          # Netlify site ID (Site configuration > Site details)
NETLIFY_FORM_NAME=contact
CLIENTVERSE_URL=http://localhost   # Clientverse base URL as seen from this host
CLIENTVERSE_TOKEN=        # Sanctum token from Clientverse > Account
